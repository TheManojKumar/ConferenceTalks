# Copy to `.env` and edit, or set these inline on the command line.

# Which local Ollama model powers the copilot. Must support tool calling.
# 24 GB GPU picks: llama3.1:8b (fast) or qwen2.5:14b (more reliable chaining for Demo B).
OLLAMA_MODEL=qwen2.5:14b

# Where the app reaches Ollama (Docker Desktop default points at the host).
OLLAMA_HOST=http://host.docker.internal:11434

# Which demo: A = copilot-as-insider (single exfil), B = agentic chain (recon->...->spread)
SCENARIO=A

# off = vulnerable (attack succeeds), on = controls block it
DEFENSE=off

# Sink URL as seen from your browser
SINK_PUBLIC_URL=http://localhost:9000

MAX_AGENT_STEPS=10
